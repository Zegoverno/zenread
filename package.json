{
  "name": "zenread",
  "version": "0.1.2",
  "description": "A calm Markdown reader with reading aids: a PWA, a zenbot plugin and an MCP App.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.pwa.config.ts",
    "build": "npm run build:app && npm run build:pwa && npm run build:server",
    "build:app": "vite build --config vite.app.config.ts",
    "build:pwa": "vite build --config vite.pwa.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "test:smoke": "node tests/mcp-smoke.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && vitest run && npm run build && npm run test:smoke && npm run test:e2e && npm run test:pack",
    "pack": "npm run build && node scripts/pack.mjs",
    "test:pack": "node tests/pack-smoke.mjs"
  },
  "dependencies": {
    "@lezer/common": "^1.2.3",
    "@lezer/markdown": "^1.8.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "happy-dom": "^20.0.0",
    "playwright": "1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zegoverno/zenread.git"
  },
  "author": "Zegoverno"
}
